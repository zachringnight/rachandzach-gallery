# Copy to .env.local and fill in real values there. NEVER commit real values.
# Every value below is a placeholder. Nothing falls back to a default secret.

# --- Supabase (local stack values come from `supabase start` / `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-anon-key-from-supabase-status
# Server-only. Never expose with a NEXT_PUBLIC_ prefix, never sent to browsers.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-from-supabase-status
# Optional, for direct psql/tooling access to the local database only.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Guest sessions. There is no site password: GALLERY_PASSWORD_HASH was
# removed on 2026-08-09 along with the /enter door, and the whole site now
# answers anonymous requests. This secret signs the per-browser session cookie
# that favorites and upload batches are keyed to -- an identity, not a
# permission. Set it: without it guests silently lose their favorites between
# visits. It is not, however, load-bearing for access, so a missing value
# degrades that one feature instead of taking the site down.
# At least 32 random bytes. Generate with: openssl rand -hex 32
GALLERY_SESSION_SECRET=paste-64-hex-chars-from-openssl-rand-hex-32

# --- Read-only import source (never written to)
SOURCE_PHOTO_DIR=/Users/zsoskin/Rachel & Zach - Wedding Master Clean

# --- Optional browser save providers. These are public client identifiers,
# never client secrets. Leave unset to hide that provider.
# Google: Web OAuth client, Drive API enabled, authorized JavaScript origins
# configured. The app requests only the drive.file scope.
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=
# Dropbox: Saver app key with localhost/production domains configured.
NEXT_PUBLIC_DROPBOX_APP_KEY=
