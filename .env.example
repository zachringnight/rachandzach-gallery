# Copy to .env.local and fill in real values there. NEVER commit real values.
# Every value below is a placeholder. Production credentials fail closed:
# missing values throw, nothing falls back to a default secret.

# --- Supabase (local stack values come from `supabase start` / `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-anon-key-from-supabase-status
# Server-only. Never expose with a NEXT_PUBLIC_ prefix, never sent to browsers.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-from-supabase-status
# Optional, for direct psql/tooling access to the local database only.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Guest and admin access (packet 04). Both values below are REQUIRED in
# production. Missing values fail closed at runtime with a clear configuration
# error; the build itself never needs them. Only the Argon2id hash of the
# shared guest password is ever configured; never store the plain password.
# Generate the hash locally with:
#   node -e "require('@node-rs/argon2').hash('the-password').then(console.log)"
GALLERY_PASSWORD_HASH=paste-argon2id-hash-never-the-plain-password
# At least 32 random bytes. Generate with: openssl rand -hex 32
GALLERY_SESSION_SECRET=paste-64-hex-chars-from-openssl-rand-hex-32
# (Legacy GALLERY_REQUIRE_PASSWORD flag removed at packet 12 cutover: the old
# static gallery, its importer, and its components no longer exist.)

# --- Read-only import source (never written to)
SOURCE_PHOTO_DIR=/Users/zsoskin/Downloads/Rachel & Zach - Wedding Master Clean
