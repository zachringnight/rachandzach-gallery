ds-bundle/
.design-sync/
.ds-sync/
# Vendored OpenCV face-detection/recognition ONNX models (37M + 228K) used by
# scripts/find-manual-person-matches.py and scripts/suggest-untagged-people.py.
# Excluded from git for the same reason as .venv-faces/: large vendored
# binaries, not source, and this network has a documented problem pushing
# large single request bodies (see docs/HANDOFF_CURRENT.md "Operational war
# stories"). Re-fetch locally rather than committing; do not add without
# discussing storage (Git LFS or a fetch script) first.
models/
# Playwright MCP tool cache (DOM/console dumps from ad hoc browser
# automation sessions); pure tool exhaust, never source, never commit.
.playwright-mcp/
# Internal Remotion timing-board renders; source lives in motion-study/.
.motion-output/
.vercel
# Supabase CLI link/cache metadata is machine-local and regenerated.
supabase/.temp/

# Coding-agent git worktrees (full checkouts of this repo, inside this repo)
.claude/worktrees/

# Ad hoc one-off scripts written during a debugging session. Scratch by
# convention: if a *.tmp.mjs turns out to be worth keeping, rename it into
# scripts/ so it gets a header comment and review rather than lingering
# untracked in the repo root.
*.tmp.mjs
