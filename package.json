{
  "name": "rachandzach-gallery",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "npm run verify:vercel && npm run typecheck && npm run lint && npm run test && npm run verify:build && npm run verify:search-runtime && npx playwright test tests/e2e --project=chromium",
    "verify:vercel": "node scripts/validate-vercel-json.mjs",
    "verify:build": "GALLERY_SESSION_SECRET=2f5d4b704e008d71d178b75581ea1c1d6ef4e4ca604f46940bdaddb4301c0d06 NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54329 NEXT_PUBLIC_SUPABASE_ANON_KEY=synthetic-anon-key-e2e-only SUPABASE_URL=http://127.0.0.1:54329 SUPABASE_SERVICE_ROLE_KEY=synthetic-service-role-key-e2e-only npm run build",
    "verify:search-runtime": "node scripts/verify-search-runtime-trace.mjs",
    "verify:catalog": "node scripts/verify-gallery-catalog.mjs",
    "verify:originals": "node scripts/verify-original-integrity.mjs",
    "verify:egress": "node scripts/estimate-storage-egress.mjs",
    "motion:study": "remotion still motion-study/index.ts PersonalAtlasMotionStudy .motion-output/personal-atlas.png --frame=45 --browser-executable='/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'",
    "gallery:import": "node scripts/build-gallery-v2.mjs",
    "embeddings:import": "uv run --python 3.12 scripts/build-embeddings.py",
    "types:generate": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "audit:metadata": "node scripts/audit-people-metadata.mjs",
    "merge:agent-reviews": "node scripts/merge-agent-reviews.mjs",
    "sort:metadata": "node scripts/sort-photos-by-metadata.mjs",
    "build:identity-review": "node scripts/build-identity-review-assets.mjs",
    "build:naming-tool": "node scripts/build-naming-tool.mjs",
    "faces:recurring": "node scripts/face/build-recurring-face-tagger.mjs --open",
    "faces:recurring:build": "node scripts/face/build-recurring-face-tagger.mjs",
    "faces:recurring:apply": "node scripts/face/import-recurring-face-decisions.mjs",
    "faces:unresolved": "node scripts/face/build-unresolved-cluster-report.mjs",
    "faces:merge:live": "node scripts/sync-live-person-merge.mjs",
    "tag": "node scripts/tag-faces.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@react-email/components": "^1.0.12",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.8",
    "@uppy/core": "^5.2.0",
    "@uppy/react": "^5.2.0",
    "@uppy/tus": "^5.1.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@zip.js/zip.js": "^2.8.34",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "heic-decode": "^2.1.0",
    "lucide-react": "^1.25.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.18.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tus-js-client": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@remotion/cli": "^4.0.409",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/heic-decode": "^2.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "jsdom": "^30.0.1",
    "remotion": "^4.0.409",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "adm-zip": "^0.6.0"
  }
